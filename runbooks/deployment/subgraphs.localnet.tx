
action "coop_meme_bonding_curve_started_event" "svm::deploy_subgraph" {
    program_id = action.deploy_coop_meme.program_id
    program_idl = action.deploy_coop_meme.program_idl
    block_height = 0 // action.deploy_coop_meme.block_height
    event {
        name = "BondingCurveStartedEvent"
    }
}

